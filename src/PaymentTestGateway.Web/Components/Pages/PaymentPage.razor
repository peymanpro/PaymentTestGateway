@page "/pay/{PaymentId:guid}"
@rendermode InteractiveServer
@using PaymentTestGateway.Application.Interfaces
@using PaymentTestGateway.Domain.Entities

@inject HttpClient Http
@inject NavigationManager Navigation


@inject IPaymentService PaymentService

<PageTitle>Payment Test Gateway</PageTitle>

<div class="payment-container">

    @if (Payment is null)
    {
        <div class="alert alert-danger">
            Payment not found.
        </div>
    }
    else
    {
        <div class="payment-container">

            <div class="payment-card">

                ...

            </div>

        </div>
    }
    <div class="payment-card">

        <div class="payment-header">
            <h2>Payment Test Gateway</h2>
            <p>Sandbox Environment</p>
        </div>

        <div class="payment-body">

            <div class="info-row">
                <span>Payment Id</span>
                <strong>@PaymentId</strong>
            </div>

            <div class="info-row">
                <span>Amount</span>
                <strong>$ @(Payment?.Amount ?? 0)</strong>
            </div>

            <div class="info-row">
                <span>Description</span>
                <strong>@Payment?.Description</strong>
            </div>

        </div>

        <div class="payment-actions">

            <button class="btn btn-success" @onclick="SuccessPayment">
                Successful Payment
            </button>

            <button class="btn btn-danger" @onclick="FailedPayment">
                Failed Payment
            </button>

            <button class="btn btn-outline-secondary" @onclick="CancelPayment">
                Cancel
            </button>

        </div>

    </div>

</div>

@code
{
    [Parameter]
    public Guid PaymentId { get; set; }

    private PaymentTransaction? Payment;

    protected override void OnInitialized()
    {
        Payment = PaymentService.GetById(PaymentId);
    }

    private async Task SuccessPayment()
    {
        var response = await Http.PostAsync(
            $"api/payment/{PaymentId}/success",
            null);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo($"/payment-result/{PaymentId}");
        }
    }

    private async Task FailedPayment()
    {
        var response = await Http.PostAsync(
            $"api/payment/{PaymentId}/failed",
            null);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo($"/payment-result/{PaymentId}");
        }
    }

    private async Task CancelPayment()
    {
        var response = await Http.PostAsync(
            requestUri: $"api/payment/{PaymentId}/cancel",
            null);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo($"/payment-result/{PaymentId}");
        }
    }
}